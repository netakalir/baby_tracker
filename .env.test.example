# E2E test configuration. Copy this file to `.env.test` (git-ignored) and fill in
# the value below. VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are read from the
# existing `.env`, so you normally only need to set the service_role key here.
#
# The service_role key bypasses Row Level Security and is used ONLY to seed and
# delete throwaway test users/families. Never commit it and never use it in app code.
# Find it in: Supabase Dashboard -> Project Settings -> API -> service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: override the app URL the tests drive (defaults to http://localhost:5173).
# E2E_BASE_URL=http://localhost:5173
