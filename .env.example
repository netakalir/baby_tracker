# Frontend environment variables. Copy this file to `.env` (git-ignored) and
# fill in the values. Only `VITE_`-prefixed vars are exposed to the client
# bundle. NEVER put a secret that must stay private (e.g. a Supabase
# service_role key) in a `VITE_` var — it ships to the browser.

# --- Supabase (required) ---
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Sentry error monitoring (optional) ---
# Frontend DSN. Leave empty to disable monitoring entirely (a clean no-op).
# Public by design; safe to expose in the client bundle.
VITE_SENTRY_DSN=
# Environment tag on reported events. Reporting is ENABLED only when this is
# `production` or `integration`; any other value (or unset) keeps monitoring off
# even if a DSN is present, so local dev never reports. Set per Vercel env.
VITE_SENTRY_ENVIRONMENT=

# --- Sentry source-map upload (build-only, CI/Vercel) ---
# Used by @sentry/vite-plugin in vite.config.ts. The plugin activates ONLY when
# SENTRY_AUTH_TOKEN is set; with no token the build proceeds unchanged. These
# are NOT `VITE_`-prefixed and are never bundled into the client.
# SENTRY_AUTH_TOKEN is a secret — set it in the CI/Vercel build env, never here.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
